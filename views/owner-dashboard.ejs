<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/owner-admin.css">
</head>
<body>

  <!-- Login View -->
  <div id="loginView" class="center">
    <div class="auth-card">
      <div class="brand">Pibery Platform <span>SUPER ADMIN</span></div>
      <h1>অনার লগইন</h1>
      <p>আপনার প্ল্যাটফর্ম ওনার অ্যাকাউন্ট দিয়ে সাইন ইন করুন</p>
      <form id="loginForm">
        <label for="loginEmail">ইমেইল ঠিকানা</label>
        <input type="email" id="loginEmail" required placeholder="owner@pibery.online">
        <label for="loginPassword" style="margin-top:10px;display:block;">পাসওয়ার্ড</label>
        <input type="password" id="loginPassword" required placeholder="••••••••">
        <button type="submit" style="margin-top:16px;">লগইন করুন</button>
      </form>
      <div id="loginError" class="error"></div>
    </div>
  </div>

  <!-- Main App View -->
  <div id="appView" class="app hidden">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="brand" style="font-size:20px;font-weight:800;">Pibery <span style="font-size:10px;background:#ffffff1a;color:#fff;padding:3px 6px;border-radius:6px;margin-left:4px;">ADMIN</span></div>
      <nav>
        <a class="active" data-tab="overview">📊 ড্যাশবোর্ড ওভারভিউ</a>
        <a data-tab="shops">🏪 সকল শপ ম্যানেজমেন্ট</a>
        <a data-tab="users">👥 ইউজার ও মার্চেন্ট</a>
        <a data-tab="orders">📦 গ্লোবাল অর্ডার্স</a>
        <a data-tab="plans">💎 সাবস্ক্রিপশন প্ল্যান</a>
        <a data-tab="payouts">💸 পে-আউট রিকোয়েস্ট</a>
        <a data-tab="announcements">📢 নোটিশ ও ঘোষণা</a>
        <a data-tab="settings">⚙️ প্ল্যাটফর্ম সেটিংস</a>
      </nav>
      <button id="logoutBtn" class="ghost">🚪 লগআউট</button>
    </div>

    <!-- Main Content -->
    <div class="main">
      <header>
        <div>
          <small>Pibery Website Builder Management</small>
          <h2 id="pageTitle">ড্যাশবোর্ড ওভারভিউ</h2>
        </div>
        <div class="owner-pill">
          👑 স্বাগতম, <span id="ownerName">Owner</span>
        </div>
      </header>

      <!-- Overview Panel -->
      <div id="tab-overview" class="panel active">
        <div id="stats" class="cards">
          <!-- Dynamically filled stats -->
        </div>
        <div class="grid2">
          <div class="box">
            <div class="box-head"><h3>সাম্প্রতিক অর্ডারসমূহ</h3></div>
            <div id="recentOrders" class="list"></div>
          </div>
          <div class="box">
            <div class="box-head"><h3>সেরা শপসমূহ (টপ সেলস)</h3></div>
            <div id="topShops" class="list"></div>
          </div>
        </div>
      </div>

      <!-- Shops Panel -->
      <div id="tab-shops" class="panel">
        <div class="toolbar">
          <input type="text" id="shopSearch" placeholder="শপের নাম বা সাবডোমেইন...">
          <button onclick="loadShops()">খুঁজুন</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>শপ ও সাবডোমেইন</th><th>মালিক</th><th>প্ল্যান</th><th>স্ট্যাটাস</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody id="shopsBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Users Panel -->
      <div id="tab-users" class="panel">
        <div class="toolbar">
          <input type="text" id="userSearch" placeholder="নাম বা ইমেইল...">
          <button onclick="loadUsers()">খুঁজুন</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>ইউজার</th><th>রোল</th><th>স্ট্যাটাস</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody id="usersBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Plans Panel -->
      <div id="tab-plans" class="panel">
        <div class="toolbar">
          <button class="btn-primary" onclick="showPlanModal()">+ নতুন প্ল্যান তৈরি করুন</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>প্ল্যান নাম</th><th>মূল্য</th><th>বিলিং</th><th>প্রোডাক্ট লিমিট</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody id="plansBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Payouts Panel -->
      <div id="tab-payouts" class="panel">
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>শপ</th><th>মার্চেন্ট</th><th>পরিমাণ</th><th>পদ্ধতি</th><th>স্ট্যাটাস</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody id="payoutsBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Announcements Panel -->
      <div id="tab-announcements" class="panel">
        <div class="toolbar">
          <button class="btn-primary" onclick="showAnnouncementModal()">+ নতুন নোটিশ পাঠান</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>শিরোনাম</th><th>টাইপ</th><th>তারিখ</th><th>স্ট্যাটাস</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody id="announcementsBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Settings Panel -->
      <div id="tab-settings" class="panel">
        <div class="box" style="max-width: 600px;">
          <form id="settingsForm">
            <div class="form-group">
              <label>প্ল্যাটফর্ম নাম</label>
              <input type="text" name="platformName" id="setPlatformName">
            </div>
            <div class="form-group">
              <label>সাপোর্ট ইমেইল</label>
              <input type="email" name="platformEmail" id="setPlatformEmail">
            </div>
            <div class="form-group">
              <label>কমিশন রেট (%)</label>
              <input type="number" name="commissionRate" id="setCommissionRate">
            </div>
            <div class="form-group">
              <label><input type="checkbox" name="maintenanceMode" id="setMaintenanceMode"> মেইনটেন্যান্স মোড চালু করুন</label>
            </div>
            <button type="submit" class="btn-primary">সেটিংস সেভ করুন</button>
          </form>
        </div>
      </div>

      <!-- Orders Panel (Existing) -->
      <div id="tab-orders" class="panel">
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>অর্ডার আইডি</th><th>শপ</th><th>মোট মূল্য</th><th>স্ট্যাটাস</th></tr>
            </thead>
            <tbody id="ordersBody"></tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <script src="/js/owner-admin.js"></script>
</body>
</html>
