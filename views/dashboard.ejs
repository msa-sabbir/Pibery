<%- include('partials/header') %>

<div class="dash-layout">
  <aside class="sidebar">
    <div class="logo"><i class="fa-solid fa-store"></i> Pibery</div>
    <nav class="side-nav">
      <a href="#" data-tab="overview" class="active"><i class="fa-solid fa-gauge"></i> ওভারভিউ</a>
      <a href="#" data-tab="canvas"><i class="fa-solid fa-layer-group"></i> ক্যানভাস বিল্ডার</a>
      <a href="#" data-tab="products"><i class="fa-solid fa-box"></i> প্রোডাক্ট</a>
      <a href="#" data-tab="orders"><i class="fa-solid fa-receipt"></i> অর্ডার</a>
      <a href="#" data-tab="customers"><i class="fa-solid fa-users"></i> কাস্টমার</a>
      <a href="#" data-tab="marketing"><i class="fa-solid fa-tags"></i> মার্কেটিং</a>
      <a href="#" data-tab="theme"><i class="fa-solid fa-palette"></i> থিম</a>
      <a href="#" data-tab="export"><i class="fa-solid fa-file-export"></i> এক্সপোর্ট</a>
    </nav>
    <button id="theme-toggle" class="btn btn-ghost"><i class="fa-solid fa-moon"></i> ডার্ক মোড</button>
  </aside>

  <main class="dash-main">
    <header class="dash-header">
      <div>
        <label for="shopId">শপ আইডি:</label>
        <input id="shopId" placeholder="আপনার শপের ID পেস্ট করুন" />
      </div>
      <div id="auth-status">লগইন করা হয়নি</div>
    </header>

    <section id="tab-overview" class="tab-panel active">
      <h2>ড্যাশবোর্ড ওভারভিউ</h2>
      <div class="stat-grid">
        <div class="stat-card"><span id="stat-revenue">৳0</span><label>মোট আয়</label></div>
        <div class="stat-card"><span id="stat-orders">0</span><label>মোট অর্ডার</label></div>
        <div class="stat-card"><span id="stat-customers">0</span><label>মোট কাস্টমার</label></div>
        <div class="stat-card"><span id="stat-pending">0</span><label>পেন্ডিং অর্ডার</label></div>
      </div>
      <button class="btn btn-primary" onclick="loadDashboard()">রিফ্রেশ করুন</button>
    </section>

    <section id="tab-canvas" class="tab-panel">
      <h2>ক্যানভাস বিল্ডার</h2>
      <p>ক্লিক করে সেকশন যোগ করুন — লাইভ প্রিভিউ নিচে দেখা যাবে।</p>
      <div class="canvas-toolbar">
        <button class="btn" onclick="addSection('hero')">+ হিরো সেকশন</button>
        <button class="btn" onclick="addSection('feature-grid')">+ ফিচার গ্রিড</button>
        <button class="btn" onclick="addSection('pricing-table')">+ প্রাইসিং টেবিল</button>
        <button class="btn btn-primary" onclick="saveCanvas()">সেভ করুন</button>
      </div>
      <div id="canvas-preview" class="canvas-preview"></div>
    </section>

    <section id="tab-products" class="tab-panel">
      <h2>প্রোডাক্ট ম্যানেজমেন্ট</h2>
      <form id="product-form" class="inline-form">
        <input name="name" placeholder="প্রোডাক্টের নাম" required />
        <input name="price" type="number" placeholder="দাম" required />
        <input name="stock" type="number" placeholder="স্টক" required />
        <input name="category" placeholder="ক্যাটাগরি" />
        <button type="submit" class="btn btn-primary">যোগ করুন</button>
      </form>
      <table class="data-table" id="product-table">
        <thead><tr><th>নাম</th><th>দাম</th><th>স্টক</th><th>ক্যাটাগরি</th><th></th></tr></thead>
        <tbody></tbody>
      </table>
    </section>

    <section id="tab-orders" class="tab-panel">
      <h2>অর্ডার প্রসেসিং</h2>
      <table class="data-table" id="order-table">
        <thead><tr><th>অর্ডার আইডি</th><th>মোট</th><th>স্ট্যাটাস</th><th>আপডেট</th></tr></thead>
        <tbody></tbody>
      </table>
    </section>

    <section id="tab-customers" class="tab-panel">
      <h2>কাস্টমার রিলেশনশিপ</h2>
      <table class="data-table" id="customer-table">
        <thead><tr><th>নাম</th><th>ইমেইল</th><th>মোট অর্ডার</th><th>লয়্যালটি পয়েন্ট</th></tr></thead>
        <tbody></tbody>
      </table>
    </section>

    <section id="tab-marketing" class="tab-panel">
      <h2>মার্কেটিং ও কুপন</h2>
      <form id="coupon-form" class="inline-form">
        <input name="code" placeholder="কুপন কোড (যেমন: SAVE20)" required />
        <input name="title" placeholder="শিরোনাম" required />
        <select name="discountType">
          <option value="percentage">শতাংশ (%)</option>
          <option value="fixed">নির্দিষ্ট পরিমাণ</option>
        </select>
        <input name="discountValue" type="number" placeholder="মান" required />
        <button type="submit" class="btn btn-primary">কুপন তৈরি করুন</button>
      </form>
      <table class="data-table" id="coupon-table">
        <thead><tr><th>কোড</th><th>শিরোনাম</th><th>ছাড়</th><th>ব্যবহৃত</th></tr></thead>
        <tbody></tbody>
      </table>
    </section>

    <section id="tab-theme" class="tab-panel">
      <h2>থিম কাস্টমাইজেশন</h2>
      <p>আপনার স্টোরের প্রাইমারি কালার নির্বাচন করুন এবং লাইট/ডার্ক মোড টগল করুন।</p>
      <input type="color" id="theme-color" value="#4f46e5" />
      <button class="btn btn-primary" onclick="saveTheme()">থিম সেভ করুন</button>
    </section>

    <section id="tab-export" class="tab-panel">
      <h2>প্রজেক্ট এক্সপোর্ট</h2>
      <p>আপনার স্টোরের বর্তমান কনফিগারেশন JSON আকারে এক্সপোর্ট করুন।</p>
      <button class="btn btn-primary" onclick="exportProject()">এক্সপোর্ট করুন</button>
      <pre id="export-output"></pre>
    </section>
  </main>
</div>

<%- include('partials/footer') %>
 