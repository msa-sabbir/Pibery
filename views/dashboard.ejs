<%- include('partials/header') %>

<main class="container dashboard-container" style="padding-bottom: 50px;">
    <!-- Top Platform Header -->
    <div class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 25px;">
        <div>
            <h1>Pibery Studio Dashboard</h1>
            <p>Manage your e-commerce platform, store builder, admin controls, and storefronts in real-time.</p>
        </div>
        <div class="dashboard-actions" style="display: flex; gap: 10px;">
            <button id="themeToggle" class="btn-secondary"><i class="fa-solid fa-moon"></i> Theme</button>
            <button id="exportCodeBtn" class="btn-primary"><i class="fa-solid fa-code"></i> Export Project</button>
        </div>
    </div>

    <!-- Interactive Builder Workspace -->
    <div class="builder-studio" style="display: grid; grid-template-columns: 280px 1fr; gap: 20px; margin-bottom: 35px;">
        <div class="sidebar-toolbox" style="background: #111827; padding: 20px; border-radius: 12px; border: 1px solid #1f2937;">
            <h3 style="font-size: 1.1rem; color: #38bdf8; margin-bottom: 15px;"><i class="fa-solid fa-toolbox"></i> Store Components</h3>
            <ul class="draggable-tools" style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px;">
                <li data-element="hero" style="background: #1e293b; padding: 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9;"><i class="fa-solid fa-heading"></i> Hero Section</li>
                <li data-element="features" style="background: #1e293b; padding: 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9;"><i class="fa-solid fa-th-large"></i> Features Grid</li>
                <li data-element="pricing" style="background: #1e293b; padding: 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9;"><i class="fa-solid fa-tags"></i> Pricing Table</li>
                <li data-element="contact" style="background: #1e293b; padding: 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9;"><i class="fa-solid fa-envelope"></i> Contact Form</li>
            </ul>
        </div>

        <div class="live-canvas-area" style="background: #111827; border-radius: 12px; border: 1px solid #1f2937; overflow: hidden; display: flex; flex-direction: column;">
            <div class="canvas-top-bar" style="background: #1f2937; padding: 10px 15px; display: flex; align-items: center; gap: 8px;">
                <span class="dot red" style="width: 10px; height: 10px; background: #ef4444; border-radius: 50%; display: inline-block;"></span>
                <span class="dot yellow" style="width: 10px; height: 10px; background: #f59e0b; border-radius: 50%; display: inline-block;"></span>
                <span class="dot green" style="width: 10px; height: 10px; background: #10b981; border-radius: 50%; display: inline-block;"></span>
                <span class="canvas-url" style="font-size: 0.8rem; color: #94a3b8; margin-left: 10px;">https://pibery.online/preview/workspace</span>
            </div>
            
            <div id="dropCanvas" class="canvas-content-box" style="padding: 30px; text-align: center; flex-grow: 1; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                <div class="welcome-placeholder">
                    <i class="fa-solid fa-cloud-arrow-down" style="font-size: 3rem; color: #38bdf8; margin-bottom: 15px;"></i>
                    <h3 style="color: #f1f5f9;">Your Canvas is Ready</h3>
                    <p style="color: #94a3b8; font-size: 0.9rem;">Select components from the left toolbox to build your live page structure.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 🛠️ Admin Panel & Management Features Section -->
    <div class="admin-panel-section" style="background: #111827; padding: 25px; border-radius: 14px; border: 1px solid #1f2937; margin-bottom: 25px;">
        <h2 style="font-size: 1.3rem; margin-bottom: 15px; color: #38bdf8;"><i class="fa-solid fa-gauge-high"></i> Merchant Admin Panel (Control Center)</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px;">
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-chart-line"></i> Real-Time Dashboard</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Monitor live sales, order volume, and visitor traffic instantly.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-boxes-stacked"></i> Inventory & Orders</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Process orders, print shipping labels, and track multi-location stock.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-users-gear"></i> CRM & Staff Control</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Manage customer segments, profiles, and assign staff role permissions.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-bullhorn"></i> Marketing & Coupons</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Create discount coupon codes and run target email campaigns.</p>
            </div>
        </div>
    </div>

    <!-- 🛍️ Storefront & User Shopping Features Section -->
    <div class="user-storefront-section" style="background: #111827; padding: 25px; border-radius: 14px; border: 1px solid #1f2937;">
        <h2 style="font-size: 1.3rem; margin-bottom: 15px; color: #38bdf8;"><i class="fa-solid fa-bag-shopping"></i> Storefront User Experience (Customer View)</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px;">
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-magnifying-glass"></i> Advanced Discovery</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Smart search, multi-filters (price, size, color), and sorting systems.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-cart-shopping"></i> Cart & Guest Checkout</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Seamless cart management, guest checkout, and secure payment methods.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-truck-fast"></i> Live Tracking & Returns</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Real-time fulfillment tracking and self-service return requests.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9;"><i class="fa-solid fa-award"></i> Customer Loyalty</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Earn reward points on repeat purchases and exclusive discounts.</p>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
