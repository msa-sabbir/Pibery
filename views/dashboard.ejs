<%- include('partials/header') %>

<main class="container dashboard-container">
    <div class="dashboard-header">
        <div>
            <h1>Pibery Studio Dashboard</h1>
            <p>Design, build, and manage your advanced e-commerce store instantly.</p>
        </div>
        <div class="dashboard-actions">
            <button id="themeToggle" class="btn-secondary"><i class="fa-solid fa-moon"></i> Theme</button>
            <button id="exportCodeBtn" class="btn-primary"><i class="fa-solid fa-code"></i> Export Project</button>
        </div>
    </div>

    <!-- Interactive Builder Workspace -->
    <div class="builder-studio">
        <div class="sidebar-toolbox">
            <h3><i class="fa-solid fa-toolbox"></i> Components</h3>
            <ul class="draggable-tools">
                <li data-element="hero"><i class="fa-solid fa-heading"></i> Hero Section</li>
                <li data-element="features"><i class="fa-solid fa-th-large"></i> Features Grid</li>
                <li data-element="pricing"><i class="fa-solid fa-tags"></i> Pricing Table</li>
                <li data-element="contact"><i class="fa-solid fa-envelope"></i> Contact Form</li>
            </ul>
        </div>

        <div class="live-canvas-area">
            <div class="canvas-top-bar">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
                <span class="canvas-url">https://pibery.online/preview/workspace</span>
            </div>
            
            <div id="dropCanvas" class="canvas-content-box">
                <div class="welcome-placeholder">
                    <i class="fa-solid fa-cloud-arrow-down" style="font-size: 3rem; color: #38bdf8; margin-bottom: 15px;"></i>
                    <h3>Your Canvas is Ready</h3>
                    <p>Select components from the left toolbox to build your live page structure.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Complete E-Commerce Admin & User Features Suite Section -->
    <div class="business-features-section" style="margin-top: 30px; background: #111827; padding: 25px; border-radius: 14px; border: 1px solid #1f2937;">
        <h2 style="font-size: 1.3rem; margin-bottom: 20px; color: #38bdf8;"><i class="fa-solid fa-store"></i> Pibery Full E-Commerce Admin & Storefront Suite</h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
            <div style="background: #1e293b; padding: 18px; border-radius: 10px; border: 1px solid #334155;">
                <h4 style="color: #38bdf8; margin-bottom: 8px;"><i class="fa-solid fa-chart-pie"></i> Admin Dashboard & Analytics</h4>
                <p style="font-size: 0.85rem; color: #94a3b8;">Real-time sales, order overview, traffic, customer behavior reports, and urgent alerts.</p>
            </div>
            
            <div style="background: #1e293b; padding: 18px; border-radius: 10px; border: 1px solid #334155;">
                <h4 style="color: #38bdf8; margin-bottom: 8px;"><i class="fa-solid fa-boxes-stacked"></i> Inventory & Order Fulfillment</h4>
                <p style="font-size: 0.85rem; color: #94a3b8;">Multi-location stock tracking, shipping labels, packing slips, and return management.</p>
            </div>

            <div style="background: #1e293b; padding: 18px; border-radius: 10px; border: 1px solid #334155;">
                <h4 style="color: #38bdf8; margin-bottom: 8px;"><i class="fa-solid fa-users-gear"></i> Customer & Staff Control</h4>
                <p style="font-size: 0.85rem; color: #94a3b8;">CRM profiling, segmentation, staff role permissions, and secure access assignment.</p>
            </div>

            <div style="background: #1e293b; padding: 18px; border-radius: 10px; border: 1px solid #334155;">
                <h4 style="color: #38bdf8; margin-bottom: 8px;"><i class="fa-solid fa-bag-shopping"></i> Advanced User Storefront</h4>
                <p style="font-size: 0.85rem; color: #94a3b8;">Product browsing, filtering, guest checkout, wishlist, real-time tracking, and loyalty rewards.</p>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
