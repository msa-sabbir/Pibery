<%- include('partials/header') %>

<main class="container dashboard-container" style="padding: 20px; max-width: 1200px; margin: auto;">
    <!-- Top Platform Header -->
    <div class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 25px;">
        <div>
            <h1 style="color: #38bdf8; margin: 0;">Pibery Store Management</h1>
            <p style="color: #94a3b8; margin: 5px 0 0 0;">Manage your admin controls and customer storefront seamlessly.</p>
        </div>
        <div class="dashboard-actions" style="display: flex; gap: 10px;">
            <button id="themeToggle" class="btn-secondary" style="background: #1f2937; color: #f1f5f9; border: 1px solid #374151; padding: 8px 15px; border-radius: 6px; cursor: pointer;"><i class="fa-solid fa-moon"></i> Theme</button>
            <button id="exportCodeBtn" class="btn-primary" style="background: #38bdf8; color: #0b0f19; border: none; padding: 8px 15px; border-radius: 6px; font-weight: 600; cursor: pointer;"><i class="fa-solid fa-code"></i> Export Store</button>
        </div>
    </div>

    <!-- Main Workspace Grid -->
    <div class="builder-studio" style="display: grid; grid-template-columns: 280px 1fr; gap: 20px; margin-bottom: 35px;">
        <!-- Store Components Toolbox (New Added Elements) -->
        <div class="sidebar-toolbox" style="background: #111827; padding: 20px; border-radius: 12px; border: 1px solid #1f2937;">
            <h3 style="font-size: 1.1rem; color: #38bdf8; margin-bottom: 15px;"><i class="fa-solid fa-toolbox"></i> Store Components</h3>
            <ul class="draggable-tools" style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; max-height: 400px; overflow-y: auto;">
                <li data-element="Hero Section" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-heading"></i> Hero Section</li>
                <li data-element="Features Grid" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-th-large"></i> Features Grid</li>
                <li data-element="Pricing Table" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-tags"></i> Pricing Table</li>
                <li data-element="Contact Form" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-envelope"></i> Contact Form</li>
                <li data-element="Product Showcase" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-box-open"></i> Product Showcase</li>
                <li data-element="Testimonial Slider" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-comments"></i> Testimonial Slider</li>
                <li data-element="FAQ Section" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-circle-question"></i> FAQ Section</li>
                <li data-element="Newsletter Banner" style="background: #1e293b; padding: 10px 12px; border-radius: 8px; cursor: pointer; color: #f1f5f9; font-size: 0.9rem;"><i class="fa-solid fa-paper-plane"></i> Newsletter Banner</li>
            </ul>
        </div>

        <!-- Live Canvas Preview Area -->
        <div class="live-canvas-area" style="background: #111827; border-radius: 12px; border: 1px solid #1f2937; overflow: hidden; display: flex; flex-direction: column; min-height: 420px;">
            <div class="canvas-top-bar" style="background: #1f2937; padding: 10px 15px; display: flex; align-items: center; gap: 8px;">
                <span style="width: 10px; height: 10px; background: #ef4444; border-radius: 50%; display: inline-block;"></span>
                <span style="width: 10px; height: 10px; background: #f59e0b; border-radius: 50%; display: inline-block;"></span>
                <span style="width: 10px; height: 10px; background: #10b981; border-radius: 50%; display: inline-block;"></span>
                <span style="font-size: 0.8rem; color: #94a3b8; margin-left: 10px;">https://pibery.online/preview/workspace</span>
            </div>
            
            <div id="dropCanvas" style="padding: 30px; text-align: center; flex-grow: 1; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                <div class="welcome-placeholder">
                    <i class="fa-solid fa-cloud-arrow-down" style="font-size: 3rem; color: #38bdf8; margin-bottom: 15px;"></i>
                    <h3 style="color: #f1f5f9; margin: 0 0 8px 0;">Your Store Canvas is Ready</h3>
                    <p style="color: #94a3b8; font-size: 0.9rem; margin: 0;">Click on any component from the left toolbox to inject it live.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 🛠️ Admin Panel Suite Section -->
    <div style="background: #111827; padding: 25px; border-radius: 14px; border: 1px solid #1f2937; margin-bottom: 25px;">
        <h2 style="font-size: 1.2rem; margin-bottom: 15px; color: #38bdf8;"><i class="fa-solid fa-gauge-high"></i> Admin Control Panel (Merchant & Staff)</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 15px;">
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-chart-line"></i> Live Dashboard</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Real-time sales, order volume, and traffic analytics.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-boxes-stacked"></i> Order & Inventory</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Stock tracking, shipping labels, and return handling.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-users-gear"></i> CRM & Staff</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Customer profiles, segmentation, and staff roles.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-bullhorn"></i> Marketing & Coupons</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Discount codes, campaigns, and promotional tools.</p>
            </div>
        </div>
    </div>

    <!-- 🛍️ Storefront User Experience Section -->
    <div style="background: #111827; padding: 25px; border-radius: 14px; border: 1px solid #1f2937;">
        <h2 style="font-size: 1.2rem; margin-bottom: 15px; color: #38bdf8;"><i class="fa-solid fa-bag-shopping"></i> Storefront User Experience (Customer View)</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 15px;">
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-magnifying-glass"></i> Product Discovery</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Advanced search, multi-filters, and sorting systems.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-cart-shopping"></i> Cart & Checkout</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Guest checkout, cart management, and secure gateways.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-truck-fast"></i> Live Tracking</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Real-time order delivery tracking and self-returns.</p>
            </div>
            <div style="background: #1e293b; padding: 15px; border-radius: 8px;">
                <h4 style="color: #f1f5f9; margin: 0 0 5px 0;"><i class="fa-solid fa-award"></i> Loyalty Rewards</h4>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">Earn reward points and discounts on repeat buys.</p>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
